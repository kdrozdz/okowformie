# Copy to .env.local for local (non-docker) development, or wire equivalent
# values through docker-compose's environment/env_file for the frontend service.
#
# Base URL of the backend API, reachable from the browser.
# NEXT_PUBLIC_* variables are inlined into the client-side JS bundle at build
# time by Next.js — they are public by definition, never put secrets here.
# In docker-compose dev network the backend container is reachable server-side
# as "http://backend:8000", but the *browser* on the host needs a host-reachable
# URL (e.g. http://localhost:8000) since it runs outside the compose network.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL of the backend API, reachable from within the frontend container
# (server-side only — Server Components, generateMetadata, generateStaticParams).
# No NEXT_PUBLIC_ prefix, so Next.js never inlines it into the client bundle.
# In the docker-compose dev network the backend container is reachable as
# "http://backend:8000"; for non-docker local dev, point it at wherever the
# backend actually runs (e.g. http://localhost:8000).
API_URL=http://backend:8000

# Public base URL of the frontend itself, reachable from the browser — used
# once, in app/layout.tsx, as `metadataBase` so relative canonical/OG URLs
# resolve correctly. NEXT_PUBLIC_* (see note above): public by definition,
# never a secret.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

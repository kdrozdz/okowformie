# Zbiorczy plik env dla lokalnego `docker compose up -d` (root repo).
#
# Użycie: `cp env.example .env` — Docker Compose sam wczyta `.env` z katalogu
# obok `docker-compose.yml` przy podstawianiu `${VAR}`. Kopiowanie jest
# opcjonalne: każda zmienna w `docker-compose.yml` ma devowy default
# (`${VAR:-default}`), więc `docker compose up -d` działa też bez `.env`.
#
# Uwaga o nazwie pliku: brak wiodącej kropki jest celowy, dla spójności z
# `backend/env.example` i `frontend/env.example`. Powód tamtych: sandbox
# Claude Code w tym repo ma w `.claude/settings.json` regułę
# `deny: Read(./.env*)`, którą backend-agent/frontend-agent odczytali jako
# blokadę całego wzorca `.env.*` (w rzeczywistości reguła blokuje tylko
# `Read`, nie `Write` — Write/Edit nie są objęte tym `deny`). Efekt uboczny:
# ten plik (i pochodne `.env` skopiowane z niego) nie są chronione tą regułą
# przed przypadkowym odczytem przez agentów w przyszłych sesjach — to do
# rozważenia przez użytkownika — czy rozszerzyć `deny` o `Read(./env*)` /
# `Read(./**/env.example)`, czy zostawić jak jest (pliki *.example z
# defaultami dev, bez prawdziwych sekretów, więc ryzyko jest niskie — ale
# skopiowany z niego `.env` z prawdziwym `SECRET_KEY` już powinien być
# chroniony, i teoretycznie jest, bo `.env` zaczyna się kropką).
#
# Źródło prawdy dla poszczególnych usług:
#   backend/env.example  — zmienne Django (opisy, jak generować SECRET_KEY itd.)
#   frontend/env.example — zmienne Next.js
# Tutaj tylko agregacja pod docker-compose, z wartościami dopasowanymi do
# nazw usług w sieci compose (`db`, `cache`), nie do `localhost`.

# --- Postgres (usługa `db`) --------------------------------------------

POSTGRES_DB=backend
POSTGRES_USER=backend
POSTGRES_PASSWORD=change-me

# --- Redis (usługa `cache`) ----------------------------------------------
# Backend łączy się po nazwie usługi w sieci compose, nie `localhost`.
# Ustawiane też wprost w docker-compose.yml (topologia sieci, nie sekret) —
# tu dla kompletności/dokumentacji i na wypadek użycia poza compose.

REDIS_URL=redis://cache:6379/0

# --- Django (usługa `backend`) -------------------------------------------

# Generuj przez: uv run --project backend manage.py shell -c
#   "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me

# True tylko lokalnie, nigdy w prod.
DEBUG=True

# Lista rozdzielona przecinkami, bez wildcardów. `backend` = nazwa usługi w
# sieci compose (potrzebne, gdyby coś odpytywało backend po tej nazwie).
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Lista originów frontendu (Next.js) widocznych z przeglądarki hosta.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Ścieżka panelu admina (bezpieczeństwo przez niestandardowy URL).
ADMIN_URL=panel-redakcyjny/

# --- Next.js (usługa `frontend`) ------------------------------------------

# Musi być URL-em wywoływalnym przez przeglądarkę na hoście (nie nazwą
# usługi docker `backend`) — patrz komentarz w docker-compose.yml.
NEXT_PUBLIC_API_URL=http://localhost:8000

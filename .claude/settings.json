{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(python manage.py check:*)",
      "Bash(python manage.py showmigrations:*)",
      "Bash(python manage.py makemigrations --dry-run:*)",
      "Bash(python manage.py sqlmigrate:*)",
      "Bash(python manage.py test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx playwright test:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose build:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker volume ls:*)",
      "Bash(docker images:*)",
      "Bash(docker start:*)",
      "Bash(docker stop:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git ls-files:*)",
      "Bash(pre-commit run:*)",
      "WebFetch(domain:docs.djangoproject.com)",
      "WebFetch(domain:www.django-rest-framework.org)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:developer.mozilla.org)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(python manage.py migrate:*)",
      "Bash(python manage.py makemigrations:*)",
      "Bash(docker compose down:*)",
      "Bash(aws:*)",
      "Bash(terraform apply:*)",
      "Bash(npm install:*)",
      "Bash(pip install:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git branch -D:*)",
      "Bash(python manage.py flush:*)",
      "Bash(python manage.py sqlflush:*)",
      "Bash(python manage.py dbshell:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)",
      "Bash(terraform destroy:*)",
      "Bash(aws s3 rb:*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws rds delete-db-instance:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/secrets*.y*ml)",
      "Read(./**/*credentials*)",
      "Edit(./backend/**/migrations/**)"
    ]
  }
}

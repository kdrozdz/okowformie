# Wspólny .gitignore dla całego monorepo (backend + frontend).
# Wcześniej osobne pliki w /backend i /frontend — scalone tutaj.

# --- Backend (Django / Python, uv) ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
staticfiles/
db.sqlite3
.coverage
.coverage.*
htmlcov/
# Domyślny MEDIA_ROOT, zanim ustalimy docelowy storage (S3 vs VPS) — patrz
# otwarta decyzja w CLAUDE.md. Uploady deweloperskie nie trafiają do repo.
# Zakotwiczone do konkretnej ścieżki (nie bare `media/`) — bez `/` z przodu
# ta reguła łapała też `frontend/src/lib/media/`, katalog kodu źródłowego,
# nie uploadów.
/backend/media/

# --- Frontend (Next.js / Node) ---
node_modules/
/frontend/.next/
/frontend/out/
/frontend/build/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
*.tsbuildinfo
next-env.d.ts
# Auto-generowane przez CLI Next.js 16 przy każdym `next dev`, nikt ich
# ręcznie nie edytuje — traktowane jak .next/, nie jak nasza dokumentacja.
/frontend/AGENTS.md
/frontend/CLAUDE.md

# --- Sekrety (nigdy w repo; "env.example" to celowo nie ".env*") ---
.env
.env.*
*.pem
*.key

# --- Edytor / OS ---
.DS_Store
Thumbs.db
.idea/

# --- Logi lokalne ---
*.log

# --- Claude Code: osobiste nadpisania, nie współdzielone ---
.claude/settings.local.json

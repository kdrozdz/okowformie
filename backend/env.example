# Skopiuj do `.env` na potrzeby dev (docker-compose i `uv run manage.py`
# wczytują go automatycznie). W produkcji te zmienne ustawia hosting
# (AWS) — nic z tego nie trafia do repo.
#
# Uwaga: plik nazwany `env.example` (bez wiodącej kropki) celowo — sandbox
# tego środowiska blokuje zapis/odczyt jakiegokolwiek pliku pasującego do
# wzorca `.env.*`. `infra-agent`/`docker-compose` powinien wskazywać na ten
# plik jako źródło zmiennych (`env_file: backend/env.example` w dev, albo
# skopiowany lokalnie do `backend/.env`).

# --- Django ---------------------------------------------------------------

# Generuj przez: uv run manage.py shell -c
#   "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me

# True tylko lokalnie, nigdy w prod.
DEBUG=True

# Lista rozdzielona przecinkami, bez wildcardów. Puste dozwolone tylko przy DEBUG=True.
ALLOWED_HOSTS=localhost,127.0.0.1

# Lista rozdzielona przecinkami originów frontendu (Next.js), bez wildcardów.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Ścieżka panelu admina (bezpieczeństwo przez niestandardowy URL).
ADMIN_URL=panel-redakcyjny/

# --- Baza danych ------------------------------------------------------------
# Podaj albo DATABASE_URL, albo komplet POSTGRES_*. DATABASE_URL ma pierwszeństwo.

# DATABASE_URL=postgres://backend:backend@db:5432/backend
POSTGRES_DB=backend
POSTGRES_USER=backend
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Cache (Redis) ------------------------------------------------------

REDIS_URL=redis://redis:6379/0

# --- Media (obrazy okładek postów) -----------------------------------------
# Backend storage jest domyślny (`STORAGES` Django). Docelowy magazyn — S3
# czy wolumen na VPS — to wciąż otwarta decyzja w `CLAUDE.md`; kod nie
# zakłada ścieżek lokalnych, więc podmiana nie wymaga migracji danych.
# W produkcji katalog mediów ma leżeć POZA katalogiem aplikacji i być
# serwowany przez reverse proxy/CDN (`.claude/rules/security.md`).

# MEDIA_URL=media/
# MEDIA_ROOT=/var/lib/okowformie/media

# Publiczny adres serwisu, używany do budowania absolutnych URL-i obrazów
# w API (`photo`, `certificate.image`, `cover_image`) — NIE bierzemy hosta
# z nagłówka `Host` przychodzącego żądania, bo server-side fetch z kontenera
# frontendu w docker compose ma inny host (`http://backend:8000`) niż
# publiczna domena, i to on trafiłby do `og:image`/JSON-LD. W dev wartość
# ma wskazywać na adres wywoływalny przez przeglądarkę (`localhost:8000`),
# w produkcji — na publiczną domenę.
SITE_URL=http://localhost:8000
